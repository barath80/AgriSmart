    "kill-port": "powershell -Command \"$proc = Get-NetTCPConnection -LocalPort 8081 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -Unique; if ($proc) { Stop-Process -Id $proc -Force; Write-Host 'Killed process on port 8081' } else { Write-Host 'No process on port 8081' }\""
