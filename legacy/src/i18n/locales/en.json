  "soilTest": {
    "title": "Check Soil Test",
    "subtitle": "Analyze soil quality",
    "importance": "Importance of Soil Testing",
    "importanceText": "Soil testing is essential for optimal crop production. It helps determine nutrient levels, pH, and soil composition to make informed fertilizer and amendment decisions.",
    "howToTest": "How to Test Your Soil",
    "step1": "Step 1: Planning",
    "step1Text": "Divide your field into uniform areas based on soil type, topography, and crop history. Each area should be sampled separately for accurate results.",
    "step2": "Step 2: Sampling Tools",
    "step2Text": "Use a soil auger or spade to collect samples. Take 15-20 sub-samples from each area at a depth of 6-8 inches for most crops.",
    "step3": "Step 3: Sample Collection",
    "step3Text": "Mix all samples from one area thoroughly. Remove stones, roots, and debris. Air-dry the sample (do not use oven) and pack in a clean container.",
    "step4": "Step 4: Labeling",
    "step4Text": "Clearly label each sample with field location, date, crop grown, and your contact information. This ensures accurate reporting and recommendations.",
    "step5": "Step 5: Submission",
    "step5Text": "Send samples to a certified soil testing laboratory. Most labs provide detailed reports within 7-14 days with nutrient levels and fertilizer recommendations.",
