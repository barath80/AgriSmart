# Copy to deploy/.env and fill in. Never commit the filled-in file.
POSTGRES_PASSWORD=
JWT_SECRET=                      # python -c "import secrets; print(secrets.token_urlsafe(48))"
BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.in
BOOTSTRAP_ADMIN_PASSWORD=        # at least 12 characters; change after first login

PUBLIC_BASE_URL=https://api.yourdomain.in     # used for the Twilio webhook and stream URLs
PUBLIC_ADMIN_URL=https://admin.yourdomain.in

API_REPLICAS=3
WEB_CONCURRENCY=2                # uvicorn workers per API container (≈ CPU cores)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
ML_MAX_CONCURRENCY=2

MARKET_PROVIDER=import           # or data_gov_in (+ DATA_GOV_IN_API_KEY)
DATA_GOV_IN_API_KEY=
SCHEME_PROVIDER=verified_file    # or myscheme (+ MYSCHEME_API_KEY from API Setu)
MYSCHEME_API_KEY=
VOICE_PROVIDER=none              # sarvam (+ SARVAM_API_KEY) or bhashini for Indian-language voice
SARVAM_API_KEY=
BHASHINI_USER_ID=
BHASHINI_API_KEY=
LLM_PROVIDER=none
GEMINI_API_KEY=
SMS_PROVIDER=console             # optional: twilio adds SMS alerts and "forgot password" by code
TWILIO_ACCOUNT_SID=               # login SMS + alert calls to button phones
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
HTTP_PORT=80
