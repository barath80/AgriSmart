# Copy to backend/.env for local development. In production, set these as real
# environment variables / secrets — never commit a filled-in .env.

ENVIRONMENT=development                 # development | production
DATABASE_URL=postgresql+asyncpg://agrismart:agrismart@localhost:5432/agrismart
# Connections per worker process. Keep  instances × workers × (POOL + OVERFLOW)  below
# PostgreSQL max_connections (budget in deploy/docker-compose.yml, measurements in
# loadtest/README.md). A request waits at most DB_POOL_TIMEOUT_SECONDS, then gets a 503.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-32b
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081

# First admin account (created at startup if it does not exist yet)
BOOTSTRAP_ADMIN_EMAIL=admin@example.in
BOOTSTRAP_ADMIN_PASSWORD=

# Models trained in ml/notebooks (relative to the repo by default)
# MODEL_DIR=../ml/artifacts
ML_MAX_CONCURRENCY=4                    # parallel inferences per worker (CPU-bound)

# Market prices: "agmarknet" (live, official, no key), "import" (CSV uploads, default) or
# "data_gov_in" (live API with a key)
MARKET_PROVIDER=import
DATA_GOV_IN_API_KEY=
# DATA_GOV_IN_BASE_URL=https://api.data.gov.in   # set to a relay if this host is blocked

# Government schemes: verified_file (seeds/schemes.json only) or myscheme (live sync;
# request an API key for myScheme through API Setu: https://apisetu.gov.in).
SCHEME_PROVIDER=verified_file
MYSCHEME_API_KEY=
SCHEME_SYNC_HOURS=24

# Voice. FREE option: "gemini" works with a free Google AI Studio key (GEMINI_API_KEY below) for
# speech recognition, speech output and translation in all 11 languages. "sarvam" (best Indian TTS/ASR, multi-voice; key at dashboard.sarvam.ai),
# "bhashini" (free registration at bhashini.gov.in), "local" (Whisper ASR only) or "none"
VOICE_PROVIDER=none
# Backup when the main voice provider fails (e.g. Sarvam out of credits): "gemini" keeps
# speech recognition, male/female voices and translation working with GEMINI_API_KEY.
VOICE_FALLBACK_PROVIDER=none
SARVAM_API_KEY=
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# Optional LLM for open conversation only: none | ollama | gemini
LLM_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Button-phone line (Twilio)
PUBLIC_BASE_URL=http://localhost:8000
# Farmers sign in with a password, so no SMS is needed to log in. "console" only logs messages;
# choose "twilio" (paid) only to send SMS alerts and "forgot password" codes.
SMS_PROVIDER=console
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_ACCOUNT_SID=                      # login SMS + alert calls to button phones
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MAX_CONCURRENT_CALLS=20
MAX_CALL_SECONDS=600

# Abuse protection
RATE_LIMIT_PER_MINUTE=60
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
