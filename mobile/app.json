{
  "expo": {
    "name": "AgriSmart",
    "slug": "agrismart",
    "scheme": "agrismart",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.agrismart.app"
    },
    "android": {
      "package": "in.agrismart.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8F5E9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "AgriSmart listens to your question when you press the microphone."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "AgriSmart uses the camera to photograph a sick leaf or a pest.",
          "photosPermission": "AgriSmart can check a photo of a leaf or pest from your gallery."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgriSmart uses your location for local weather, market prices and schemes."
        }
      ],
      "expo-notifications",
      "expo-font",
      "expo-asset"
    ]
  }
}
